      <connect from_op="Optimize Parameters (Grid) SVM" from_port="performance" to_port="result 2"/>
      <connect from_op="Optimize Parameters (Grid) KNN" from_port="performance" to_port="result 1"/>
      <portSpacing port="source_input 1" spacing="0"/>
